---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
const books = (await getCollection("readings")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Books · Alejandro Barroso"
  ><div class="container">
    <PageIntro
      eyebrow="Reading shelf"
      title="Books"
      description="A record of what I’m reading—and the ideas that stayed with me after the last page."
    />
    <div class="shelf">
      {
        books.map((book) => (
          <a href={`/books/${book.id}`} class="book">
            <>
              <p class="date">
                {book.data.date.getFullYear()} · {book.data.status}
              </p>
              <h2>{book.data.title}</h2>
              <p class="author">{book.data.author}</p>
            </>
            {book.data.notes && <p class="notes">{book.data.notes}</p>}
            <span class="arrow">Read note →</span>
          </a>
        ))
      }
    </div>
  </div></BaseLayout
>
<style>
  .shelf {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid rgba(241, 241, 241, 0.16);
    padding-bottom: var(--space-7);
  }
  .book {
    padding: 2.5rem 2rem 2.5rem 0;
    border-bottom: 1px solid rgba(241, 241, 241, 0.16);
    min-height: 19rem;
    display: flex;
    flex-direction: column;
  }
  .book:nth-child(even) {
    padding-left: 2rem;
    padding-right: 0;
    border-left: 1px solid rgba(241, 241, 241, 0.16);
  }
  .date,
  .author,
  .notes {
    color: var(--color-text-muted);
  }
  .date {
    font-size: 0.85rem;
    text-transform: capitalize;
    margin-bottom: auto;
  }
  h2 {
    font-size: 1.55rem;
    margin: 1.25rem 0 0.5rem;
  }
  .notes {
    margin-top: 1rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .arrow {
    color: var(--color-accent);
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: 0.9rem;
  }
  .book:hover h2 {
    color: var(--color-accent);
  }
  @media (max-width: 700px) {
    .shelf {
      grid-template-columns: 1fr;
    }
    .book:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
