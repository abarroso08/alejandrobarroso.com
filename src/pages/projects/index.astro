---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Projects · Alejandro Barroso">
  <div class="container">
    <PageIntro eyebrow="Selected work" title="Projects" description="Things I’ve made to learn, to solve a problem, or simply because I wanted them to exist." />
    <div class="project-list">
      {projects.map((project) => <a class="project" href={`/projects/${project.id}`}>
        <div class="project-meta"><span>{project.data.status}</span><time datetime={project.data.date.toISOString()}>{project.data.date.getFullYear()}</time></div>
        <div><h2>{project.data.title}</h2><p>{project.data.description}</p></div>
        <div class="tags">{project.data.tags.map(tag => <span>{tag}</span>)}</div>
      </a>)}
    </div>
  </div>
</BaseLayout>
<style>
  .project-list { border-top: 1px solid rgba(241,241,241,.16); padding-bottom: var(--space-7); }
  .project { display: grid; grid-template-columns: 8rem 1fr auto; gap: var(--space-4); padding: 2.25rem 0; border-bottom: 1px solid rgba(241,241,241,.16); }
  .project:hover h2 { color: var(--color-accent); } .project-meta, .tags { color: var(--color-text-muted); font-size: .85rem; text-transform: capitalize; }
  .project-meta { display: flex; flex-direction: column; gap: .25rem; } h2 { font-size: 1.5rem; margin-bottom: .5rem; transition: color 180ms ease; }
  p { color: var(--color-text-muted); max-width: 45ch; } .tags { display: flex; gap: .5rem; align-self: start; flex-wrap: wrap; justify-content: end; }
  .tags span:not(:last-child)::after { content: '·'; margin-left: .5rem; }
  @media (max-width: 700px) { .project { grid-template-columns: 1fr; gap: .8rem; } .project-meta { flex-direction: row; gap: 1rem; } .tags { justify-content: start; } }
</style>
