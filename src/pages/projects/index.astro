---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projects · Alejandro Barroso">
  <div class="container">
    <PageIntro
      eyebrow="Selected work"
      title="Projects"
      description="Things I’ve made to learn, to solve a problem, or simply because I wanted them to exist."
    />
    <div class="project-list">
      {
        projects.map((project) => (
          <a class="project" href={`/projects/${project.id}`}>
            <div class="project-top">
              <h2>{project.data.title}</h2>

              <div class="project-meta">
                <div class="tags">
                  {project.data.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              </div>
            </div>

            <span class="metadata">
              {project.data.status} ·
              <time datetime={project.data.date.toISOString()}>
                {project.data.date.toLocaleDateString("en-GB", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                })}
              </time>
            </span>
            <p>{project.data.description}</p>
            <span class="arrow">Read note →</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
<style>
  .project-list {
    border-top: 1px solid rgba(241, 241, 241, 0.16);
    padding-bottom: var(--space-7);
  }

  .project {
    display: block;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(241, 241, 241, 0.16);
  }

  .project:hover h2 {
    color: var(--color-accent);
  }

  .project-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .project-top h2 {
    font-size: 1.5rem;
    margin: 0;
    transition: color 180ms ease;
  }

  .project-meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    text-transform: capitalize;
    white-space: nowrap;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: flex-end;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .tags span:not(:last-child)::after {
    content: "·";
    margin-left: 0.5rem;
  }

  .project > p {
    color: var(--color-text-muted);
    max-width: 65ch;
    margin: 0.4rem 0 0;
  }

  .metadata {
    font-size: 1rem;
    padding-top: 1rem;
    color: var(--color-text-muted);
    text-transform: capitalize;
  }
  .arrow {
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: 0.9rem;
  }
  .arrow:hover {
    color: var(--color-accent);
  }

  @media (max-width: 700px) {
    .project {
      padding: 1.5rem 0;
    }

    .project-top {
      display: block;
    }

    .project-meta {
      justify-content: flex-start;
      margin-top: 0.5rem;
      flex-wrap: wrap;
    }

    .tags {
      justify-content: flex-start;
    }

    .project > p {
      margin-top: 0.6rem;
    }
  }
</style>
