---
import "../styles/global.css";

import Navbar from "../components/layout/Navbar.astro";

interface Props{

title?:string;

}

const{

title="Alejandro Barroso"

}=Astro.props;

const isNotLandingPage =
  Astro.url.pathname === "/about" ||
  Astro.url.pathname === "/projects" ||
  Astro.url.pathname === "/books";

---

<!doctype html>

<html lang="en">

<head>

<meta charset="UTF-8"/>

<meta
name="viewport"
content="width=device-width, initial-scale=1"/>

<title>{title}</title>

</head>

<body>

<div class="page">



<main>

{isNotLandingPage && <div class="container"><a class="back-home" href="/">← Go back</a></div>}

<slot/>

</main>

<Navbar/>

</div>

</body>

</html>

<style>
  .back-home {
    display: inline-block;
    padding-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: .8rem;
  }

  .back-home:hover { color: var(--color-text); }
</style>
