---
interface Props { eyebrow: string; title: string; description: string; }
const { eyebrow, title, description } = Astro.props;
---
<header class="intro">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}<span>.</span></h1>
  <p>{description}</p>
</header>
<style>
  .intro { padding: 7rem 0 4.5rem; }
  .eyebrow { color: var(--color-accent); font-size: .95rem; margin-bottom: var(--space-3); }
  h1 { font-size: clamp(3.5rem, 9vw, 7rem); margin-bottom: var(--space-3); }
  h1 span { color: var(--color-accent); }
  .intro > p:last-child { color: var(--color-text-muted); max-width: 53ch; }
  @media (max-width: 700px) { .intro { padding: 4.5rem 0 3.5rem; } }
</style>
